# =============================================
# DocPro Elite - Variables d'Environnement
# =============================================

# Supabase Configuration
# Obtenez ces valeurs depuis votre dashboard Supabase (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre-cle-anon-publique-ici

# OpenAI API (Optionnel - Pour les fonctionnalités IA)
# Obtenez une clé sur https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-votre-cle-openai-ici

# =============================================
# Configuration Avancée (Optionnel)
# =============================================

# Next.js
# NODE_ENV=development
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Analytics (Optionnel)
# NEXT_PUBLIC_VERCEL_ANALYTICS_ID=
# SENTRY_DSN=

# =============================================
# Instructions
# =============================================
# 1. Copiez ce fichier vers .env.local
# 2. Remplacez les valeurs de Supabase par les vôtres
# 3. (Optionnel) Ajoutez votre clé OpenAI
# 4. NE COMMITEZ JAMAIS .env.local dans Git !
